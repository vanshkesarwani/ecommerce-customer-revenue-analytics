// Author: Vansh Kesarwani
// Standard: Enterprise Business Intelligence & Data Modeling Best Practices
// =============================================================================

// =============================================================================
// 1. FINANCIAL & REVENUE MEASURES (Table: _Measures_Financial)
// =============================================================================

Total GMV = 
SUM(Fact_OrderItems[price])
/* Total pure product merchandise sales (Gross Merchandise Value) */

Total Freight = 
SUM(Fact_OrderItems[freight_value])
/* Total shipping charges collected from customers */

Total Customer Cash Inflow = 
[Total GMV] + [Total Freight]
/* Total gross cash processed (merchandise + shipping) */

Total Delivered Orders = 
CALCULATE(
    DISTINCTCOUNT(Fact_Orders[order_id]),
    Fact_Orders[order_status] = "delivered"
)
/* Total count of fulfilled, recognized customer orders */

Average Order Value (AOV) = 
DIVIDE([Total GMV], [Total Delivered Orders], 0)
/* Average product spend per completed order */

Average Items Per Order = 
DIVIDE(
    COUNTROWS(Fact_OrderItems),
    [Total Delivered Orders],
    0
)
/* Average physical item units included in each transaction */

Freight-to-Price Ratio % = 
DIVIDE([Total Freight], [Total GMV], 0)
/* Shipping cost expressed as a percentage of product merchandise value */


// =============================================================================
// 2. TIME INTELLIGENCE & GROWTH MEASURES (Table: _Measures_TimeIntelligence)
// =============================================================================

GMV Previous Month = 
CALCULATE(
    [Total GMV],
    DATEADD(Dim_Date[Date], -1, MONTH)
)
/* Merchandise revenue in the prior calendar month */

MoM GMV Growth % = 
VAR _Current = [Total GMV]
VAR _Prior = [GMV Previous Month]
RETURN
    DIVIDE(_Current - _Prior, _Prior, BLANK())
/* Month-over-Month percentage revenue expansion */

Orders Previous Month = 
CALCULATE(
    [Total Delivered Orders],
    DATEADD(Dim_Date[Date], -1, MONTH)
)
/* Order volume in the prior calendar month */

MoM Order Growth % = 
VAR _Current = [Total Delivered Orders]
VAR _Prior = [Orders Previous Month]
RETURN
    DIVIDE(_Current - _Prior, _Prior, BLANK())
/* Month-over-Month percentage order volume expansion */

Cumulative Running GMV = 
CALCULATE(
    [Total GMV],
    FILTER(
        ALLSELECTED(Dim_Date[Date]),
        Dim_Date[Date] <= MAX(Dim_Date[Date])
    )
)
/* Running cumulative GMV total across the active timeline */


// =============================================================================
// 3. CUSTOMER RETENTION & LIFETIME VALUE MEASURES (Table: _Measures_Customer)
// =============================================================================

Total Unique Customers = 
DISTINCTCOUNT(Dim_Customers[customer_unique_id])
/* Count of distinct human buyers, eliminating proxy token duplicates */

Repeat Customers = 
CALCULATE(
    DISTINCTCOUNT(Dim_Customers[customer_unique_id]),
    FILTER(
        Dim_Customers,
        CALCULATE(
            DISTINCTCOUNT(Fact_Orders[order_id]),
            Fact_Orders[order_status] = "delivered"
        ) > 1
    )
)
/* Distinct buyers who placed 2 or more delivered orders */

One-Time Customers = 
[Total Unique Customers] - [Repeat Customers]
/* Buyers who have placed only a single transaction */

Repeat Purchase Rate % = 
DIVIDE([Repeat Customers], [Total Unique Customers], 0)
/* Customer retention percentage across the entire buyer base */

Average Revenue Per Customer (ARPC) = 
DIVIDE([Total GMV], [Total Unique Customers], 0)
/* Lifetime merchandise value generated per unique human customer */

Customer Revenue Share % = 
DIVIDE(
    [Total GMV],
    CALCULATE([Total GMV], ALLSELECTED(Dim_Customers)),
    0
)
/* Share of total revenue generated by a selected customer group or state */


// =============================================================================
// 4. LOGISTICS & OPERATIONAL EFFICIENCY MEASURES (Table: _Measures_Operations)
// =============================================================================

Average Delivery Lead Time Days = 
AVERAGE(Fact_Orders[delivery_lead_time_days])
/* Average calendar days elapsed from purchase to doorstep delivery */

Average Promised Delivery Days = 
AVERAGE(Fact_Orders[estimated_lead_time_days])
/* Average calendar days quoted as delivery deadline at checkout */

Average Delivery Variance Days = 
AVERAGE(Fact_Orders[delivery_delay_days])
/* Positive = delivered late; Negative = delivered ahead of schedule */

On-Time Delivered Orders = 
CALCULATE(
    COUNTROWS(Fact_Orders),
    Fact_Orders[delivery_performance] = "On-Time",
    Fact_Orders[order_status] = "delivered"
)
/* Count of orders delivered on or before the estimated delivery date */

Late Delivered Orders = 
CALCULATE(
    COUNTROWS(Fact_Orders),
    Fact_Orders[delivery_performance] = "Late",
    Fact_Orders[order_status] = "delivered"
)
/* Count of orders delivered after the promised delivery deadline */

On-Time Delivery Rate % = 
DIVIDE(
    [On-Time Delivered Orders],
    CALCULATE(
        COUNTROWS(Fact_Orders),
        Fact_Orders[order_status] = "delivered",
        NOT(ISBLANK(Fact_Orders[order_delivered_customer_date]))
    ),
    0
)
/* Percentage of fulfilled orders meeting the promised delivery SLA */

Late Delivery Rate % = 
DIVIDE(
    [Late Delivered Orders],
    CALCULATE(
        COUNTROWS(Fact_Orders),
        Fact_Orders[order_status] = "delivered",
        NOT(ISBLANK(Fact_Orders[order_delivered_customer_date]))
    ),
    0
)
/* Percentage of fulfilled orders missing the promised delivery deadline */


// =============================================================================
// 5. CUSTOMER EXPERIENCE & SATISFACTION MEASURES (Table: _Measures_CX)
// =============================================================================

Total Customer Reviews = 
COUNTROWS(Dim_Reviews)
/* Total count of customer feedback surveys submitted */

Customer Satisfaction Score (CSAT) = 
AVERAGE(Dim_Reviews[review_score])
/* Average customer review score on a 1.0 to 5.0 scale */

Positive Reviews Count = 
CALCULATE(
    COUNTROWS(Dim_Reviews),
    Dim_Reviews[review_score] >= 4
)
/* Count of favorable reviews (4-Star and 5-Star) */

Negative Reviews Count = 
CALCULATE(
    COUNTROWS(Dim_Reviews),
    Dim_Reviews[review_score] <= 2
)
/* Count of detractor reviews (1-Star and 2-Star) */

Positive Review Rate % = 
DIVIDE([Positive Reviews Count], [Total Customer Reviews], 0)
/* Favorable review proportion (promoters) */

Negative Review Rate % = 
DIVIDE([Negative Reviews Count], [Total Customer Reviews], 0)
/* Detractor review proportion (dissatisfied buyers) */

